{
  "name": "CapitalPledge",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Full name or entity name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Contact email"
    },
    "amount": {
      "type": "number",
      "description": "Pledge amount in dollars"
    },
    "tier": {
      "type": "string",
      "enum": [
        "participant",
        "junior_contributor",
        "senior_contributor",
        "growth_accelerator",
        "mentor",
        "growth_leader",
        "custom"
      ],
      "description": "Capital tier level"
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "contacted",
        "converted",
        "declined"
      ],
      "default": "registered",
      "description": "Pledge status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or custom terms"
    }
  },
  "required": [
    "full_name",
    "email",
    "amount",
    "tier"
  ]
}